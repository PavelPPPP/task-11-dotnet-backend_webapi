{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SelfFinance;Trusted_Connection=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "AddressHost": "https://localhost:7281", 

  "ApiBasePaths": {
    "Incomes": {
      "List": "/api/incomes",
      "Item": "/api/incomes/",
      "Add": "/api/incomes/add",
      "Edit": "/api/incomes/edit/",
      "Delete": "api/incomes/delete/"
    },
    "Expenses": {
      "List": "/api/expenses",
      "Item": "/api/expenses/",
      "Add": "/api/expenses/add",
      "Edit": "/api/expenses/edit/",
      "Delete": "api/expenses/delete/"
    },
    "TypesIncomes": {
      "List": "/api/typeIncomes",
      "Item": "/api/typeIncomes/",
      "Add": "/api/typeIncomes/add",
      "Edit": "/api/typeIncomes/edit",
      "Delete": "/api/typeIncomes/delete/"
    },
    "TypesExpenses": {
      "List": "/api/typeExpenses",
      "Item": "/api/typeExpenses/",
      "Add": "/api/typeExpenses/add",
      "Edit": "/api/typeExpenses/edit/",
      "Delete": "api/typeExpenses/delete/"
    },
    "Report": {
      "ToDate": "/api/report/toDate/",
      "ByPeriod": "/api/report/period"
    }
  }
}
