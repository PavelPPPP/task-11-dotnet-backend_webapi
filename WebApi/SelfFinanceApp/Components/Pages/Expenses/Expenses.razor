@page "/expenses/{currentPage:int=1}"
@using InfrastructureApi.DTO
@using SelfFinanceApp.Components.DataGrid
@using SelfFinanceApp.Components.Layout
@using SelfFinanceApp.Common

@inherits BaseEntityPage<ExpenseDTO>

@rendermode RenderMode.InteractiveServer

@if (listEntity == null)
{
    <SpinnerLoading />
}
else
{
    <BaseDataGrid Items="@listEntity"
                  PageTitle="Expenses"
                  CurrentPage="@CurrentPage"
                  RequestUriForLoadData="@requestUriForLoad"
                  UriAddPageItem="@uriAddPageItem"
                  UriEditPageItem="@((item) => String.Format(uriBaseEditPageItem!, item.Id))"
                  RequestUriForDeleteItem="@((item) => RoutesEntity.GetRouteEntity(nameApiController, item.Id))">
        <HeaderColumnsTemplate>
            <th scope="col">Name Expense</th>
            <th scope="col">Date</th>
            <th scope="col">Time</th>
            <th scope="col">Amount</th>
        </HeaderColumnsTemplate>
        <ColumnsTemplate>
            <td>@context.TypeExpense!.Name</td>
            <td>@context.CreateDate!.Value.ToShortDateString()</td>
            <td>@context.CreateDate!.Value.ToLongTimeString()</td>
            <td>@context.Amount!.Value</td>
        </ColumnsTemplate>
    </BaseDataGrid>
}

@code {

}
